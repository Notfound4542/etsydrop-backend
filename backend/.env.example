# =============================================================
# EtsyDrop backend — variables d'environnement
# Copie ce fichier en ".env" et remplis les valeurs réelles.
# Ne JAMAIS committer le fichier ".env" (secrets réels) dans git.
# =============================================================

# === ETSY API (OAuth 2.0 + PKCE — voir routers/auth.py) ===
ETSY_API_KEY=
ETSY_API_SECRET=
# Doit être l'URL PUBLIQUE DU BACKEND (Railway), jamais celle du frontend —
# c'est Etsy qui redirige le navigateur ici en GET après autorisation.
# Doit être enregistrée EXACTEMENT à l'identique (schéma, host, path) dans
# Etsy Developers > ton app > Redirect URIs, sinon Etsy refuse l'échange.
# Exemple : https://etsydrop-backend-production.up.railway.app/api/auth/etsy/callback
ETSY_REDIRECT_URI=http://localhost:8000/api/auth/etsy/callback

# === SUPABASE (Auth + base de données Postgres) ===
SUPABASE_URL=
# Clé service_role (Project Settings > API > service_role secret key) —
# nécessaire pour que le backend contourne la Row Level Security (voir
# database_schema.sql). Ne JAMAIS utiliser la clé anon/publishable ici.
SUPABASE_KEY=
# Clé anon/publishable (Project Settings > API) — utilisée UNIQUEMENT pour
# vérifier les sessions utilisateur (voir database.py > get_current_user).
# Même valeur que celle déjà publique côté frontend : ce n'est pas un secret.
# Nécessaire séparément de SUPABASE_KEY : appeler /auth/v1/user avec la clé
# service_role en apikey renvoie 403 Forbidden côté Supabase (voir l'incident
# consigné dans l'historique git de database.py).
SUPABASE_ANON_KEY=
# Plus de SUPABASE_JWT_SECRET : depuis la migration des clés JWT Supabase
# (HS256 -> ECC P-256), la vérification passe par un appel direct à l'API
# Supabase Auth (voir database.py) plutôt que par un décodage JWT local avec
# un secret partagé.

# === SOURCING MULTI-FOURNISSEURS (voir routers/sourcing.py > /search) ===
EPROLO_TOKEN=
# Base URL de l'API Eprolo pour l'import catalogue par fournisseur (Phase 2,
# routers/suppliers.py > /products/import). La clé API utilisée est celle
# saisie par l'utilisateur pour SON fournisseur (table suppliers), pas
# EPROLO_TOKEN. Laisser vide = valeur par défaut https://open.eprolo.com/api.
EPROLO_API_BASE=
CJ_ACCESS_TOKEN=
# === ALIEXPRESS (routers/aliexpress.py) ===
# Clés de l'API Affiliate (https://developers.aliexpress.com). Laisser VIDES
# = repli automatique sur les pages publiques de recherche (résultats complets,
# mais sans variantes ni délais par pays). ALIEXPRESS_TRACKING_ID optionnel.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# === SMTP (optionnel) — envoi réel des questions/devis aux fournisseurs ===
# (routers/suppliers.py > POST /conversations/). Sans SMTP_HOST, les messages
# sont seulement stockés en DB (email_sent=false).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# === STABILITY AI (génération de mockups produit) ===
STABILITY_API_KEY=

# === ANTHROPIC (conseils IA / rapport mensuel Claude) ===
ANTHROPIC_API_KEY=

# === PINTEREST (publication automatique — voir routers/promotion.py) ===
PINTEREST_ACCESS_TOKEN=

# === META ADS (Facebook/Instagram — voir routers/ads.py) ===
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# === STRIPE (abonnement Free / Pro — voir routers/billing.py) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# === CORS — origines autorisées ===
# Dev local (ex : Live Server VS Code) et domaine de production du frontend.
# ⚠️ Une origine CORS ne contient JAMAIS de chemin (pas de /etsydrop-backend) —
# uniquement schéma + host (+ port) : c'est ce que le navigateur envoie comme
# header Origin, quel que soit le chemin de la page qui fait la requête.
FRONTEND_ORIGIN_LOCAL=http://localhost:5500
FRONTEND_ORIGIN_PROD=https://notfound4542.github.io

# === FRONTEND (redirections post-paiement Stripe + post-connexion Etsy) ===
# Ici, contrairement à FRONTEND_ORIGIN_PROD, on redirige vers une PAGE précise
# donc le chemin complet est nécessaire.
FRONTEND_URL=https://notfound4542.github.io/etsydrop-backend

# === APP ===
# "development" ou "production" — influence le niveau de log et les messages d'erreur renvoyés.
ENVIRONMENT=development
